# Root Monorepo Environment Template (DB Migrations, Seeds & Playwright E2E)
# App-specific env templates live in:
#   - apps/api/.env.example
#   - apps/web/.env.example
#   - apps/mobile/.env.example

DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-icy-resonance-a7s94hg4.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth

# Optional DB Seed Passwords (dev)
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
SEED_PARTNER_PASSWORD=
SEED_TESTER_PASSWORD=

# Optional Playwright E2E Credentials
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=
