{
  "name": "@kaesava/mobile-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./plugins/withAndroidNoBackup": {
      "types": "./plugins/withAndroidNoBackup.js",
      "import": "./plugins/withAndroidNoBackup.js",
      "require": "./plugins/withAndroidNoBackup.js"
    }
  },
  "dependencies": {
    "@kaesava/config": "workspace:*",
    "@kaesava/types": "workspace:*"
  },
  "peerDependencies": {
    "expo-constants": "*",
    "expo-haptics": "*",
    "expo-local-authentication": "*",
    "expo-notifications": "*",
    "expo-secure-store": "*",
    "expo-sqlite": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  }
}
