{
  "name": "@kaesava/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@kaesava/config": "workspace:*",
    "@kaesava/db": "workspace:*",
    "@kaesava/types": "workspace:*",
    "@neondatabase/serverless": "^0.9.0",
    "drizzle-orm": "^0.39.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "lint": "eslint . --cache"
  }
}
