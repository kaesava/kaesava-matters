      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "require": "./src/web/index.ts"
    },
    "./mobile": {
      "types": "./src/mobile/index.ts",
      "import": "./src/mobile/index.ts",
      "require": "./src/mobile/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts",
      "require": "./src/router/index.ts"
    }
  },
  "dependencies": {
    "@money-matters/config": "workspace:*",
    "@money-matters/core": "workspace:*",
    "@money-matters/db": "workspace:*",
    "@money-matters/i18n": "workspace:*",
    "@money-matters/types": "workspace:*",
    "@money-matters/ui": "workspace:*",
