    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@expo/vector-icons": "^15.0.0 || ^14.0.0",
    "react": "^19.0.0 || ^18.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@types/react": "^19.1.0",
    "react-native": "0.81.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
