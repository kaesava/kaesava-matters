#!/usr/bin/env bash
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" && "${ALLOW_PROD_PUSH:-}" != "true" ]]; then
    echo "Push to main blocked: production deploys trigger on push to main."
    echo "Run: ALLOW_PROD_PUSH=true git push"
    exit 1
  fi
done
