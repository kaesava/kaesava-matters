{
  "name": "kaesava-matters-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*/*",
    "packages/*",
    "packages/capabilities/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-i18n": "turbo run check-i18n",
    "dev": "npx concurrently -k -p \"[{name}]\" -n \"app,inngest,dbstudio\" -c \"cyan,magenta,black\" \"turbo run dev\" \"pnpm run dev:inngest\" \"pnpm run db:studio\"",
    "start": "node scripts/start-dev.mjs",
    "stop": "node scripts/start-dev.mjs --stop",
    "start:tradie": "node scripts/start-dev.mjs --product=tradie-matters",
    "stop:tradie": "node scripts/start-dev.mjs --product=tradie-matters --stop",
    "start:all": "node scripts/start-dev.mjs --product=all --clean",
    "stop:all": "node scripts/start-dev.mjs --product=all --stop",
    "dev:inngest": "npx inngest-cli@latest dev --no-discovery --poll-interval 60 -u http://127.0.0.1:3001/api/inngest -u http://127.0.0.1:3011/api/inngest",
    "db:studio": "pnpm --filter=@kaesava/db studio",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "vitest run --config vitest.affected.config.ts --changed --passWithNoTests",
    "test:coverage": "turbo run test:coverage --concurrency=4",
    "test:coverage:affected": "turbo run test:coverage --affected --concurrency=4",
    "audit:schema": "node scripts/audit-schema-usage.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:mobile-interaction": "node scripts/check-mobile-interaction.mjs",
    "check:lockfile": "node scripts/check-lockfile-sync.mjs",
    "validate": "pnpm check:lockfile && pnpm check:boundaries && pnpm check-i18n && pnpm audit:schema && pnpm check:mobile-interaction && turbo run typecheck lint test:coverage",
    "validate:prod": "pnpm validate && turbo run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "version:bump": "node scripts/version-bump.mjs",
    "mm:version:bump": "node scripts/version-bump.mjs --product=money-matters",
    "tm:version:bump": "node scripts/version-bump.mjs --product=tradie-matters",
    "seed": "pnpm --filter @kaesava/db seed",
    "seed:prod": "pnpm --filter @kaesava/db seed:prod",
    "db:migrate": "pnpm --filter @kaesava/db migrate",
    "db:migrate:prod": "pnpm --filter @kaesava/db migrate:prod",
    "app:set-flag": "pnpm --filter @kaesava/db app:set-flag",
    "app:set-flag:prod": "pnpm --filter @kaesava/db app:set-flag:prod",
    "app:set-flag:all": "pnpm --filter @kaesava/db app:set-flag:all",
    "mm:mobile:build:preview": "pnpm --filter @money-matters/mobile build:preview",
    "mm:mobile:build:prod": "pnpm --filter @money-matters/mobile build:prod",
    "mm:mobile:build:submit": "pnpm --filter @money-matters/mobile build:submit",
    "tm:mobile:build:preview": "pnpm --filter @tradie-matters/mobile build:preview",
    "tm:mobile:build:prod": "pnpm --filter @tradie-matters/mobile build:prod",
    "tm:mobile:build:submit": "pnpm --filter @tradie-matters/mobile build:submit"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "connect": "^3.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "turbo": "2.0.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "~19.1.10",
      "@types/react-dom": "^19.0.0",
      "vite": "^6.0.0",
      "react-native-screens": "4.16.0",
      "react-native-svg": "15.12.1",
      "@expo/vector-icons": "15.1.1",
      "@react-native-community/datetimepicker": "8.4.4",
      "expo-constants": "~18.0.14"
    }
  },
  "type": "module"
}
