# API Worker (apps/api) Local Development Environment Template
# Copy to apps/api/.env.development for local `wrangler dev`.
# Production non-secret vars live in apps/api/wrangler.toml; production secrets live in Cloudflare `wrangler secret`.

DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-icy-resonance-a7s94hg4.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-icy-resonance-a7s94hg4.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Upstash Redis (leave blank in dev to use in-process rate-limiter fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email & Async Workflows
RESEND_API_KEY=
RESEND_FROM_EMAIL=Money Matters <info@moneymatters.kaesava.au>
INNGEST_EVENT_KEY=mock-inngest-event-key
INNGEST_SIGNING_KEY=mock-inngest-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDING_ANNUAL=

# R2 Object Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=money-matters-dev

# Cloudflare AI & Observability
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_API_TOKEN=
AI_MODEL_ID=@cf/meta/llama-3.1-8b-instruct
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
EXPO_ACCESS_TOKEN=
