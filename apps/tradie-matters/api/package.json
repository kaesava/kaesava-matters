{
  "name": "@tradie-matters/api",
  "version": "0.1.0",
  "private": true,
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3011 --inspector-port 9230 --var ENVIRONMENT:development",
    "build": "wrangler build",
    "cf-deploy": "wrangler build && wrangler deploy",
    "lint": "eslint \"**/*.ts\" --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@kaesava/capability-auth": "workspace:*",
    "@kaesava/capability-billing": "workspace:*",
    "@kaesava/capability-bug-reports": "workspace:*",
    "@kaesava/capability-calendar": "workspace:*",
    "@kaesava/capability-chat": "workspace:*",
    "@kaesava/capability-file-notes": "workspace:*",
    "@kaesava/capability-geo": "workspace:*",
    "@kaesava/capability-notifications": "workspace:*",
    "@kaesava/capability-tenant": "workspace:*",
    "@kaesava/config": "workspace:*",
    "@kaesava/core": "workspace:*",
    "@kaesava/db": "workspace:*",
    "@kaesava/i18n": "workspace:*",
    "@kaesava/types": "workspace:*",
    "@tradie-matters/capability-integrations": "workspace:*",
    "@tradie-matters/capability-operations": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.39.0",
    "inngest": "^3.19.14",
    "stripe": "^18.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
