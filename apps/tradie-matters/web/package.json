{
  "name": "@tradie-matters/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "next dev --webpack -p 3010",
    "build": "next build --webpack",
    "cf-build": "opennextjs-cloudflare build",
    "cf-deploy": "pnpm opennextjs-cloudflare build && wrangler deploy",
    "lint": "eslint . --cache",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@kaesava/capability-auth": "workspace:*",
    "@kaesava/config": "workspace:*",
    "@kaesava/core": "workspace:*",
    "@kaesava/i18n": "workspace:*",
    "@kaesava/types": "workspace:*",
    "@kaesava/ui": "workspace:*",
    "next": "16.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.14.9",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
