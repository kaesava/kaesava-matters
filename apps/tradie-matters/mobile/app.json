{
  "expo": {
    "name": "Tradie Matters",
    "slug": "tradie-matters",
    "scheme": "tradiematters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.kaesava.tradiematters",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Tradie Matters.",
        "NSLocationWhenInUseUsageDescription": "Tradie Matters uses your location to verify job site check-ins and calculate travel ETA for On My Way SMS."
      }
    },
    "android": {
      "package": "au.kaesava.tradiematters",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FA"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-notification-small.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tradie Matters accesses your photo library to attach worksite photos, compliance certificates, and supplier receipts.",
          "cameraPermission": "Tradie Matters uses your camera to capture worksite photos and scan supplier receipts."
        }
      ],
      "@kaesava/mobile-core/plugins/withAndroidNoBackup"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a112897-a327-4ed6-9b37-3cc4990a762b"
      }
    },
    "owner": "kaesava"
  }
}
