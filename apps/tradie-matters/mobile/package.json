{
  "name": "@tradie-matters/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "(adb reverse tcp:3011 tcp:3011 2>/dev/null || true) && set -a && [ -f .env.development ] && . ./.env.development; set +a && expo start --port 8082",
    "android": "(adb reverse tcp:3011 tcp:3011 2>/dev/null || true) && set -a && [ -f .env.development ] && . ./.env.development; set +a && expo start --android --port 8082",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production",
    "build:submit": "eas build --platform android --profile production --auto-submit",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:ios:submit": "eas build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.5",
    "@expo/vector-icons": "^15.1.1",
    "@kaesava/capability-auth": "workspace:*",
    "@kaesava/capability-billing": "workspace:*",
    "@kaesava/capability-bug-reports": "workspace:*",
    "@kaesava/capability-calendar": "workspace:*",
    "@kaesava/capability-chat": "workspace:*",
    "@kaesava/capability-file-notes": "workspace:*",
    "@kaesava/capability-geo": "workspace:*",
    "@kaesava/capability-notifications": "workspace:*",
    "@kaesava/capability-tenant": "workspace:*",
    "@kaesava/config": "workspace:*",
    "@kaesava/i18n": "workspace:*",
    "@kaesava/mobile-core": "workspace:*",
    "@kaesava/types": "workspace:*",
    "@kaesava/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tradie-matters/capability-integrations": "workspace:*",
    "@tradie-matters/capability-operations": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "better-auth": "^1.6.23",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-web-browser": "~15.0.10",
    "jszip": "^3.10.1",
    "posthog-react-native": "^4.10.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
