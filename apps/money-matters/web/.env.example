# Web App (Next.js / OpenNext Cloudflare) Environment Template
# Copy to .env.development for local development.
# Production runtime secrets (UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN)
# must be set via `wrangler secret put` in apps/web, never committed to .env files.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-icy-resonance-a7s94hg4.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_FOUNDING_OFFER=true
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Local dev auth proxy rate-limiter fallback (leave blank in dev for in-process fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
